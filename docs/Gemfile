source "https://rubygems.org"

# Static site generator
gem "jekyll", "~> 4.3"

# Documentation theme with built-in navigation and search
gem "just-the-docs", "0.8.2"

# Required by `jekyll serve` on Ruby 3+
gem "webrick", "~> 1.8"

# Plugins
group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  # Rewrites Markdown-to-Markdown links (foo.md) to their built URLs
  gem "jekyll-relative-links"
end
